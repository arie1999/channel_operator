# OpenRouter — gateway for LLM calls (Stage 2 + Stage 3).
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=

# Telegram bots — used as fallback when channel.yaml does not specify
# per-channel bot tokens. Required for Phase 1.
EDITOR_BOT_TOKEN=
PUBLISHER_BOT_TOKEN=

# The Telegram user ID that should receive editor-bot DMs.
# Get yours from @userinfobot on Telegram.
OPERATOR_TELEGRAM_USER_ID=

# Database. SQLite by default; swap to a postgresql:// URL in production.
DATABASE_URL=sqlite:///data/channels.db

# Which channel (by id) the bot operates on at runtime. Defaults to
# `psychology_today`. Override to switch to a different channel folder
# under channels/.
ACTIVE_CHANNEL_ID=psychology_today

# Optional: override the default model for ad-hoc Stage 3 testing.
# Defaults come from each channel's channel.yaml.
# MODEL=qwen/qwen3.6-plus
